<?xml version="1.0" encoding="utf-8"?>
<!--
  A part-built squad is worth restoring; the auth token is not.

  AN include MAKES THIS AN ALLOWLIST. Once any include is present, everything
  not named is already excluded, so naming auth.xml in an exclude element did
  not protect it any further. It is also a fatal error rather than harmless
  belt-and-braces, because the excluded path is not under an included one:

      backup_rules.xml:5: Error: auth.xml is not in an included path
      [FullBackupContent]

  That check is fatal on release builds only (lintVitalRelease), which is why
  every debug build and CI's own lintDebug passed over it.
-->
<full-backup-content>
    <include domain="sharedpref" path="saved_squad.xml" />
</full-backup-content>
